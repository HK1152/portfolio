generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int      @id @default(autoincrement())
  adminId   String   @unique
  password  String
  role      String   @default("admin")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Portfolio {
  id              Int       @id @default(autoincrement())
  name            String
  title           String
  email           String
  phone           String?
  linkedin        String?
  github          String?
  location        String?
  about           String?
  heroDescription String?
  cvUrl           String?
  extraActivities String[]
  
  educations      Education[]
  certifications  Certification[]
  experiences     Experience[]
  skills          SkillCategory[]
  techLogos       TechLogo[]
  projects        Project[]
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model TechLogo {
  id           Int        @id @default(autoincrement())
  portfolioId  Int
  iconName     String
  title        String
  
  portfolio    Portfolio  @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
}

model Education {
  id           Int        @id @default(autoincrement())
  portfolioId  Int
  period       String
  degree       String
  institution  String
  details      String[]
  
  portfolio    Portfolio  @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
}

model Certification {
  id           Int        @id @default(autoincrement())
  portfolioId  Int
  period       String
  title        String
  issuer       String
  details      String[]
  
  portfolio    Portfolio  @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
}

model Experience {
  id           Int        @id @default(autoincrement())
  portfolioId  Int
  period       String
  role         String
  company      String
  details      String[]
  
  portfolio    Portfolio  @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
}

model SkillCategory {
  id           Int        @id @default(autoincrement())
  portfolioId  Int
  category     String
  items        String[]
  
  portfolio    Portfolio  @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
}

model Project {
  id           Int        @id @default(autoincrement())
  portfolioId  Int
  image        String?
  title        String
  tech         String
  description  String
  liveDemo     String?
  githubLink   String?
  
  portfolio    Portfolio  @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
}
